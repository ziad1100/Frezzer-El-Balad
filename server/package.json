{
  "name": "frezzer-el-balad-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild src/workers/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.js && esbuild src/database/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed.js",
    "start": "node dist/server.js",
    "worker:prod": "node dist/worker.js",
    "seed:prod": "node dist/seed.js",
    "seed": "tsx src/database/seed.ts",
    "worker": "tsx src/workers/index.ts",
    "worker:watch": "tsx watch src/workers/index.ts",
    "migrate": "tsx src/database/run-migrations.ts",
    "migrate:status": "tsx src/database/run-migrations.ts --status",
    "migrate:dry": "tsx src/database/run-migrations.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.9",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.4",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.22.0",
    "slugify": "^1.6.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^2.1.6",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
