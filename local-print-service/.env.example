# Freezer El Balad — Local Print Service Configuration
# Copy this file to .env and fill in your values

# Backend API URL
API_URL=https://frezzer-el-balad.onrender.com

# Authentication token (get from admin login)
API_TOKEN=your_bearer_token_here

# Printer connection type: lan | usb | bluetooth | wifi
PRINTER_CONNECTION=lan

# For LAN/WiFi printers — IP address and port
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# Poll interval in milliseconds (default: 3000 = 3 seconds)
POLL_INTERVAL=3000

# Paper width in mm: 58 | 80
PAPER_WIDTH=80
