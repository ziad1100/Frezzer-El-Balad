[TEMPLATE]
# Welad Halal — Local Print Service Configuration (Enhanced)
# Copy this file to .env and fill in your values

# Backend API URL
API_URL=https://welad-halal.onrender.com

# Authentication token (get from admin dashboard → Service Tokens)
API_TOKEN=your_service_token_here

# Printer connection type: lan | usb | bluetooth | wifi | windows
PRINTER_CONNECTION=lan

# For LAN/WiFi printers — IP address and port
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# For Windows system printers — printer name as shown in Windows Settings
#WINDOWS_PRINTER_NAME=EPSON TM-T88VI

# For Bluetooth printers — COM port (if using serial Bluetooth)
# BLUETOOTH_COM_PORT=COM3

# Poll interval in milliseconds (default: 3000 = 3 seconds)
POLL_INTERVAL=3000

# Paper width in mm: 58 | 80
PAPER_WIDTH=80

# Health check server port (for status monitoring)
HEALTH_PORT=9200

# Max retry attempts for transient failures (default: 3)
MAX_RETRIES=3

# Log level: debug | info | warn | error
LOG_LEVEL=info
