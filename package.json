{
  "name": "frezzer-el-balad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "concurrently -n server,client -c red,cyan \"npm run dev:server\" \"npm run dev\"",
    "build": "tsc -b && vite build && npm run build:api",
    "build:api": "esbuild scripts/api-handler-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/handler.js && esbuild scripts/health-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/health.js",
    "build:server": "npm run build --workspace server",
    "lint": "eslint .",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace server",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "smoke:ui": "node scripts/smoke_ui.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "backup": "node scripts/backup.mjs",
    "start": "cross-env NODE_ENV=production node server/dist/server.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "bullmq": "^6.0.9",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "swiper": "^14.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
